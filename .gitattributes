# 统一按文本处理，仓库内一律使用 LF
* text=auto eol=lf

# 可执行脚本必须是 LF，否则在 Linux 上会报 $'\r': command not found
*.sh   text eol=lf
*.py   text eol=lf
*.php  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows 批处理必须是 CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.ico  binary
